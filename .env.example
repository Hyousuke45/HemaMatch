# ==============================================================
# HemaMatch environment variables
# ==============================================================
# Phase 1 (now): none of these are needed - the app runs on mock data.
# Phase 2 (Supabase): fill these in, then set USE_MOCK = false in
#                     src/lib/dataService.js
#
# Find both values in your Supabase dashboard:
#   Project Settings -> API
#     - Project URL  -> VITE_SUPABASE_URL
#     - anon public  -> VITE_SUPABASE_ANON_KEY
# ==============================================================

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# SECURITY RULE (from the project spec):
# Variables prefixed with VITE_ are bundled into the browser - they are PUBLIC.
# NEVER put the service_role key, database passwords, or any privileged secret
# in this file. The anon key is safe because all authorization is enforced by
# Row Level Security in PostgreSQL (see supabase/schema.sql).

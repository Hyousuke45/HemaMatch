# HemaMatch environment variables (Vite)
# Copy this file to `.env` and fill in the values for YOUR Supabase project.
# Get both values from: Supabase Dashboard -> Project Settings -> API
#   - Project URL          -> VITE_SUPABASE_URL
#   - anon / public key    -> VITE_SUPABASE_ANON_KEY

# --- Supabase (Phase 2) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Mode switch (optional) ---
# Leave unset for automatic behavior:
#   - Supabase env vars present -> Supabase mode
#   - missing                   -> mock mode (localStorage)
# Set to "true" to force mock mode, "false" to force Supabase mode:
# VITE_USE_MOCK=true

# --- SECURITY (read this before your defense) ---
# Only VITE_ variables reach the browser, and ONLY these two are public by
# design — authorization is enforced by Row Level Security in PostgreSQL,
# not by hiding the key. The service_role key must NEVER be placed in this
# file or in any frontend code: it bypasses RLS entirely.
# If you ever leak it, rotate it immediately in the Supabase dashboard.
